diff --git a/common/game/compatibility/gaplog.cpp b/common/game/compatibility/gaplog.cpp
new file mode 100644
index 00000000..d4deeac9
--- /dev/null
+++ b/common/game/compatibility/gaplog.cpp
@@ -0,0 +1,179 @@
+#include "gaplog.h"
+
+#include <Tempest/Log>
+#include <zenkit/DaedalusVm.hh>
+
+#include <cstdio>
+#include <fstream>
+
+using namespace Compatibility;
+
+namespace {
+void appendEscaped(std::string& out, std::string_view s) {
+  out += '"';
+  for(char c:s) {
+    const auto u = uint8_t(c);
+    switch(c) {
+      case '"':  out += "\\\""; break;
+      case '\\': out += "\\\\"; break;
+      case '\n': out += "\\n";  break;
+      case '\r': out += "\\r";  break;
+      case '\t': out += "\\t";  break;
+      default:
+        if(u<0x20 || u>=0x7F) {
+          // the names of the scripts are cp1252 and the hidden symbols have \xFF: JSON gets them as escapes, not UTF-8
+          char buf[8];
+          std::snprintf(buf,sizeof(buf),"\\u%04x",unsigned(u));
+          out += buf;
+          } else {
+          out += c;
+          }
+      }
+    }
+  out += '"';
+  }
+
+std::string hex(uint32_t v) {
+  char buf[16];
+  std::snprintf(buf,sizeof(buf),"0x%08x",unsigned(v));
+  return buf;
+  }
+}
+
+GapLog& GapLog::inst() {
+  static GapLog log;
+  return log;
+  }
+
+void GapLog::setVm(const zenkit::DaedalusVm* v) {
+  std::lock_guard<std::recursive_mutex> guard(sync);
+  vm = v;
+  }
+
+std::string_view GapLog::kindName(Kind k) {
+  switch(k) {
+    case Kind::Call:        return "call";
+    case Kind::Hook:        return "hook";
+    case Kind::Unmapped:    return "unmapped";
+    case Kind::Field:       return "field";
+    case Kind::External:    return "external";
+    case Kind::ScriptError: return "script";
+    }
+  return "?";
+  }
+
+std::vector<std::string> GapLog::scriptStack() const {
+  std::vector<std::string> ret;
+  if(vm==nullptr)
+    return ret;
+  auto& cs = vm->call_stack();
+  for(size_t i=cs.size(); i>0 && ret.size()<10; --i) {
+    auto* f = cs[i-1].function;
+    if(f!=nullptr)
+      ret.emplace_back(f->name());
+    }
+  return ret;
+  }
+
+void GapLog::note(Kind kind, uint32_t address, std::string_view name, std::string_view cls,
+                  std::string_view detail, std::initializer_list<uint32_t> regs) {
+  note(kind,address,name,cls,detail,std::vector<uint32_t>(regs));
+  }
+
+void GapLog::note(Kind kind, uint32_t address, std::string_view name, std::string_view cls,
+                  std::string_view detail, const std::vector<uint32_t>& regs) {
+  std::lock_guard<std::recursive_mutex> guard(sync);
+  ++all;
+  // a call or an address is one gap whatever name it has (the name is looked up only the first time)
+  const bool named = kind!=Kind::Call && kind!=Kind::Unmapped;
+  Key key{uint8_t(kind),address,named ? std::string(name) : std::string(),std::string(cls)};
+  auto it = entries.find(key);
+  if(it!=entries.end()) {
+    it->second.count++;
+    dirty = true;
+    return;
+    }
+  if(entries.size()>=MaxEntries)
+    return;
+  if((kind==Kind::Unmapped || kind==Kind::Field) && ++perKind[uint8_t(kind)]>MaxPerAddressKind)
+    return;
+  Entry e;
+  e.kind    = kind;
+  e.address = address;
+  e.name    = name;
+  e.cls     = cls;
+  e.detail  = detail;
+  e.stack   = scriptStack();
+  e.regs    = regs;
+  e.count   = 1;
+  auto& ref = entries.emplace(std::move(key),std::move(e)).first->second;
+  dirty = true;
+  Tempest::Log::i("IKGAP ",entryJson(ref));
+  }
+
+std::string GapLog::entryJson(const Entry& e) const {
+  std::string s = "{\"kind\":";
+  appendEscaped(s,kindName(e.kind));
+  if(e.kind==Kind::Field)
+    s += ",\"address\":" + std::to_string(e.address); else
+    s += ",\"address\":\"" + hex(e.address) + "\"";
+  if(!e.name.empty())   { s += ",\"name\":";   appendEscaped(s,e.name);   }
+  if(!e.cls.empty())    { s += ",\"class\":";  appendEscaped(s,e.cls);    }
+  if(!e.detail.empty()) { s += ",\"detail\":"; appendEscaped(s,e.detail); }
+  if(!e.regs.empty()) {
+    s += ",\"regs\":[";
+    for(size_t i=0; i<e.regs.size(); ++i) {
+      if(i>0)
+        s += ',';
+      s += '"' + hex(e.regs[i]) + '"';
+      }
+    s += ']';
+    }
+  s += ",\"stack\":[";
+  for(size_t i=0; i<e.stack.size(); ++i) {
+    if(i>0)
+      s += ',';
+    appendEscaped(s,e.stack[i]);
+    }
+  s += "],\"count\":" + std::to_string(e.count) + "}";
+  return s;
+  }
+
+std::string GapLog::json() const {
+  std::lock_guard<std::recursive_mutex> guard(sync);
+  std::string s = "{\"schema\":1,\"total\":" + std::to_string(all) + ",\"gaps\":[\n";
+  bool first = true;
+  for(auto& [k,e]:entries) {
+    if(!first)
+      s += ",\n";
+    first = false;
+    s += entryJson(e);
+    }
+  s += "\n]}\n";
+  return s;
+  }
+
+size_t GapLog::size() const {
+  std::lock_guard<std::recursive_mutex> guard(sync);
+  return entries.size();
+  }
+
+uint64_t GapLog::total() const {
+  std::lock_guard<std::recursive_mutex> guard(sync);
+  return all;
+  }
+
+void GapLog::flush() {
+  std::lock_guard<std::recursive_mutex> guard(sync);
+  if(!dirty)
+    return;
+  // next to log.txt (the working directory of the game, the files of the application on Android)
+  std::ofstream f("ikarus-gaps.json",std::ios::binary|std::ios::trunc);
+  if(!f) {
+    Tempest::Log::e("GapLog: cannot write ikarus-gaps.json");
+    return;
+    }
+  const auto data = json();
+  f.write(data.data(),std::streamsize(data.size()));
+  dirty = false;
+  }
diff --git a/common/game/compatibility/gaplog.h b/common/game/compatibility/gaplog.h
new file mode 100644
index 00000000..ac0545fe
--- /dev/null
+++ b/common/game/compatibility/gaplog.h
@@ -0,0 +1,84 @@
+#pragma once
+
+#include <cstdint>
+#include <initializer_list>
+#include <map>
+#include <mutex>
+#include <string>
+#include <string_view>
+#include <tuple>
+#include <vector>
+
+namespace zenkit {
+class DaedalusVm;
+}
+
+namespace Compatibility {
+
+/// The machine-readable list of what the scripts of a mod asked for and did not get: a call of the engine that nobody
+/// answers, a hook that nobody fires, memory that does not exist, a field of a character that the handle does not have, an
+/// external without a binding, an error of a script.
+///
+/// The first time of every gap is a line of log.txt ("IKGAP {json}"), so it is in the reports of the phones too; the whole
+/// list with the counts is ikarus-gaps.json next to log.txt (written at a save, at the end of the game and on request).
+/// tools/ikarus/worklist.py turns them, with the static audit and the engine database, into tasks (docs/IKARUS_AUTOMATION.md).
+class GapLog {
+  public:
+    enum class Kind : uint8_t {
+      Call,         // CALL__thiscall & co: an address of the engine without a handler (Cpu32)
+      Hook,         // HookEngine: a place of the engine that OpenGothic does not fire
+      Unmapped,     // MEM_ReadInt & co: an address of the pretended memory where nothing lives
+      Field,        // a field of oCNpc/oCItem that the handle does not fill (it reads 0, a write is lost)
+      External,     // an external function of the scripts without a binding
+      ScriptError,  // an exception of the VM
+      };
+
+    static GapLog& inst();
+
+    /// The VM of the game: the functions on its call stack say who asked
+    void     setVm(const zenkit::DaedalusVm* vm);
+
+    /// `address`: the address (Call, Hook, Unmapped), the offset in the object (Field); `cls`: the class of the object (Field);
+    /// `name`: the external, the error, the functions of a hook; `regs`: ECX and the stack (Call)
+    void     note(Kind kind, uint32_t address, std::string_view name = {}, std::string_view cls = {},
+                  std::string_view detail = {}, std::initializer_list<uint32_t> regs = {});
+    void     note(Kind kind, uint32_t address, std::string_view name, std::string_view cls,
+                  std::string_view detail, const std::vector<uint32_t>& regs);
+
+    /// Writes ikarus-gaps.json (all the gaps with their counts)
+    void     flush();
+    size_t   size() const;
+    uint64_t total() const;
+    /// The gaps as JSON, for the mods (debug.gaps()) and the autorun
+    std::string json() const;
+
+    static std::string_view kindName(Kind k);
+
+  private:
+    GapLog() = default;
+
+    struct Entry {
+      Kind                     kind    = Kind::Call;
+      uint32_t                 address = 0;
+      std::string              name, cls, detail;
+      std::vector<std::string> stack;
+      std::vector<uint32_t>    regs;
+      uint64_t                 count   = 0;
+      };
+    using Key = std::tuple<uint8_t,uint32_t,std::string,std::string>;
+
+    std::string                  entryJson(const Entry& e) const;
+    std::vector<std::string>     scriptStack() const;
+
+    mutable std::recursive_mutex sync;
+    const zenkit::DaedalusVm*    vm = nullptr;
+    std::map<Key,Entry>          entries;
+    uint64_t                     all = 0;
+    bool                         dirty = false;
+    uint32_t                     perKind[8] = {};
+    static constexpr size_t      MaxEntries = 4000;
+    // a script that walks over memory that does not exist must not push the other gaps out
+    static constexpr uint32_t    MaxPerAddressKind = 1000;
+  };
+
+}
