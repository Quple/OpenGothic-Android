# Mods that come with the program: the files of mods/<id> are put into a source file, so the mod is there on every
# platform (also on a phone, where there is no folder of the program to put it into) and has the version of the program.
#
#   embed_builtin_mods(<output.cpp> <id> [<id>...])
#
# The source defines Scripting::registerBuiltinMods(ModHost&). A mod of the same id in the folder of the mods replaces it.
function(embed_builtin_mods out)
  set(body "")
  set(calls "")

  foreach(id ${ARGN})
    set(root "${CMAKE_SOURCE_DIR}/mods/${id}")
    file(GLOB_RECURSE files RELATIVE "${root}" "${root}/*")
    list(SORT files)

    set(table "")
    set(count 0)
    foreach(f ${files})
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${root}/${f}")
      file(READ "${root}/${f}" hex HEX)
      string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
      string(MAKE_C_IDENTIFIER "${id}_${f}" ident)
      string(APPEND body "static const unsigned char data_${ident}[] = {${bytes}0};\n")
      string(APPEND table "  {\"${f}\", data_${ident}, sizeof(data_${ident})-1},\n")
      math(EXPR count "${count}+1")
    endforeach()

    string(MAKE_C_IDENTIFIER "${id}" ident)
    string(APPEND body "static const BuiltinFile files_${ident}[] = {\n${table}};\n")
    string(APPEND calls "  host.addBuiltin(\"${id}\", files_${ident}, ${count});\n")
  endforeach()

  set(text "// Generated by cmake/embedmods.cmake, do not edit\n#include \"scripting/modhost.h\"\n\nnamespace Scripting {\n\n${body}\nvoid registerBuiltinMods(ModHost& host) {\n${calls}}\n\n}\n")

  # the file is written only when it has changed, so the program is not built again for nothing
  set(old "")
  if(EXISTS "${out}")
    file(READ "${out}" old)
  endif()
  if(NOT "${old}" STREQUAL "${text}")
    file(WRITE "${out}" "${text}")
  endif()
endfunction()
